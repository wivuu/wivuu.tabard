<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>tabard</AssemblyName>
    <RootNamespace>Wivuu.Tabard.Cli</RootNamespace>

    <!-- AOT is a publish-time concern and needs a RID. Leaving it off otherwise keeps
         `dotnet pack` producing a portable IL tool package. -->
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <!-- Embed the symbols rather than shipping a loose .pdb inside the tool package. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <!-- Installed as Wivuu.Tabard, which the Wivuu.* prefix reservation covers, but invoked
         as plain `tabard`. ToolCommandName is what lands on PATH; PackageId is only the id. -->
    <ToolCommandName>tabard</ToolCommandName>
    <PackageId>Wivuu.Tabard</PackageId>
    <Version>0.1.1</Version>
    <Authors>Wivuu</Authors>
    <Copyright>Copyright (c) Wivuu</Copyright>
    <Description>A Claude Code profile switcher. Launch `claude` through `tabard` and pick which login to use.</Description>
    <PackageTags>claude;claude-code;cli;profile</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wivuu/wivuu.tabard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wivuu/wivuu.tabard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../nupkg</PackageOutputPath>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wivuu.Tabard.CLI.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
