<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>tabard</AssemblyName>
    <RootNamespace>Tabard.Cli</RootNamespace>

    <!-- AOT is a publish-time concern and needs a RID. Leaving it off otherwise keeps
         `dotnet pack` producing a portable IL tool package. -->
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tabard</ToolCommandName>
    <PackageId>tabard</PackageId>
    <Version>0.1.0</Version>
    <Description>A Claude Code profile switcher. Launch `claude` through `tabard` and pick which login to use.</Description>
    <PackageTags>claude;claude-code;cli;profile</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../nupkg</PackageOutputPath>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tabard.CLI.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
